CREATE TABLE empleados_clean AS
WITH base AS (
    SELECT
        id_empleado,
        nombre_completo,
        departamento,
        ciudad,
        pais,
        email,
        telefono,
        genero,
        id_gerente,
        puntaje_desempeno,
        estado,
        salario_mensual,

        -- fecha_nacimiento:
        CASE
            WHEN fecha_nacimiento LIKE '%/%' THEN REPLACE(fecha_nacimiento, '/', '-')
            WHEN fecha_nacimiento LIKE '%.%' THEN REPLACE(fecha_nacimiento, '.', '-')
            ELSE fecha_nacimiento
        END AS fecha_nacimiento_clean,

        -- fecha_contratacion:
        CASE
            WHEN fecha_contratacion LIKE '%/%' THEN REPLACE(fecha_contratacion, '/', '-')
            WHEN fecha_contratacion LIKE '%.%' THEN REPLACE(fecha_contratacion, '.', '-')
            ELSE fecha_contratacion
        END AS fecha_contratacion_clean,

        -- salario_mensual: quita comas (separador de miles) y luego cualquier caracter
        -- que no sea número o punto decimal (esto cubre '$', espacios y cualquier
        -- código de moneda: COP, MXN, ARS, etc. 
        REGEXP_REPLACE(REPLACE(salario_mensual, ',', ''), '[^0-9.]', '') AS salario_mensual_clean
    FROM empleados_raw
)
SELECT
    -- id_empleado
    REPLACE(id_empleado, '-', '') AS id_empleado,

    -- nombre_completo (capitaliza nombre y apellido)
    CONCAT(
        UPPER(LEFT(SUBSTRING_INDEX(TRIM(nombre_completo), ' ', 1), 1)),
        LOWER(SUBSTRING(SUBSTRING_INDEX(TRIM(nombre_completo), ' ', 1), 2)),
        ' ',
        UPPER(LEFT(SUBSTRING_INDEX(TRIM(nombre_completo), ' ', -1), 1)),
        LOWER(SUBSTRING(SUBSTRING_INDEX(TRIM(nombre_completo), ' ', -1), 2))
    ) AS nombre_completo,

    -- genero
    CASE
        WHEN LOWER(TRIM(genero)) IN ('female', 'f', 'femenino', 'mujer') THEN 'F'
        WHEN LOWER(TRIM(genero)) IN ('male', 'masculino', 'hombre') THEN 'M'
        ELSE 'REVISAR'
    END AS genero,

    -- id_empleado normalizado a formato EMPxxxx
    CASE
        WHEN id_empleado REGEXP '^EMP[0-9]{4}$' THEN id_empleado
        WHEN id_empleado REGEXP '^EMP-' THEN CONCAT('EMP', LPAD(REPLACE(id_empleado, 'EMP-', ''), 4, '0'))
        WHEN id_empleado = 'nan' THEN NULL
        ELSE CONCAT('EMP', LPAD(REPLACE(id_empleado, '-', ''), 4, '0'))
    END AS id_empleado_limpio,

    -- fecha_nacimiento
    CASE
        WHEN fecha_nacimiento_clean LIKE '____-__-__' THEN STR_TO_DATE(fecha_nacimiento_clean, '%Y-%m-%d')
        WHEN CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(fecha_nacimiento_clean, '-', 2), '-', -1) AS UNSIGNED) > 12
            THEN STR_TO_DATE(fecha_nacimiento_clean, '%m-%d-%Y')
        ELSE STR_TO_DATE(fecha_nacimiento_clean, '%d-%m-%Y')
    END AS fecha_nacimiento,

    -- fecha_contratacion
    CASE
        WHEN fecha_contratacion_clean LIKE '____-__-__' THEN STR_TO_DATE(fecha_contratacion_clean, '%Y-%m-%d')
        WHEN CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(fecha_contratacion_clean, '-', 2), '-', -1) AS UNSIGNED) > 12
            THEN STR_TO_DATE(fecha_contratacion_clean, '%m-%d-%Y')
        ELSE STR_TO_DATE(fecha_contratacion_clean, '%d-%m-%Y')
    END AS fecha_contratacion,

    -- departamento
    CASE
        WHEN TRIM(LOWER(departamento)) LIKE 'fina%' THEN 'Finanzas'
        WHEN TRIM(departamento) REGEXP '^(hr|rr|recursos)' THEN 'Recursos Humanos'
        WHEN TRIM(departamento) REGEXP '^(mkt|mark|merca)' THEN 'Marketing'
        WHEN TRIM(departamento) REGEXP '^(ops|oper)' THEN 'Operaciones'
        WHEN TRIM(departamento) REGEXP '^(it|ti|t.i|information|tec)' THEN 'Tecnología'
        WHEN TRIM(departamento) REGEXP '^(sales|ventas)' THEN 'Ventas'
        ELSE 'REVISAR'
    END AS departamento,

    -- pais
    TRIM(CONCAT(UPPER(LEFT(pais, 1)), LOWER(RIGHT(pais, LENGTH(pais) - 1)))) AS pais,

    -- ciudad
    CASE
        WHEN TRIM(ciudad) REGEXP '^(Cdmx|Ciudad)' THEN 'Ciudad de México'
        WHEN TRIM(ciudad) REGEXP '^(Buenos)' THEN 'Buenos Aires'
        ELSE CONCAT(UPPER(SUBSTRING(TRIM(ciudad), 1, 1)), LOWER(SUBSTRING(TRIM(ciudad), 2)))
    END AS ciudad_clean,

    -- salario_mensual: se deja como número (sin código de moneda) para poder
    -- sumar, promediar o filtrar directamente. No se concatena 'COP' porque
    -- no todos los empleados ganan en la misma moneda.
    CAST(salario_mensual_clean AS DECIMAL(15,2)) AS salario_mensual,

    -- email
    CASE
        WHEN LOWER(TRIM(email)) LIKE '%@%.%' THEN email
        ELSE NULL
    END AS email,

    -- telefono: se limpian los caracteres de formato (+, paréntesis, espacios, guiones)
    -- y se valida que queden al menos 7 dígitos. No se agrega prefijo de país porque
    -- los empleados son de distintos países (no se puede asumir uno solo, como antes con +57).
    CASE
        WHEN LENGTH(REGEXP_REPLACE(TRIM(telefono), '[+() -]', '')) >= 7
            THEN REGEXP_REPLACE(TRIM(telefono), '[+() -]', '')
        ELSE NULL
    END AS telefono,

    -- id_gerente normalizado a formato EMPxxxx
    CASE
        WHEN id_gerente REGEXP '^EMP[0-9]{4}$' THEN id_gerente
        WHEN id_gerente REGEXP '^EMP-' THEN CONCAT('EMP', LPAD(REPLACE(id_gerente, 'EMP-', ''), 4, '0'))
        WHEN id_gerente = 'nan' THEN NULL
        ELSE CONCAT('EMP', LPAD(REPLACE(id_gerente, '-', ''), 4, '0'))
    END AS id_gerente,

    -- puntaje_desempeno
    CASE
        WHEN puntaje_desempeno BETWEEN 1 AND 5 THEN puntaje_desempeno
        ELSE NULL
    END AS puntaje_desempeno,

    -- estado
    CASE
        WHEN LOWER(estado) LIKE 'activ%' THEN 1
        WHEN LOWER(estado) LIKE 'inactiv%' THEN 0
        ELSE NULL
    END AS estado

FROM base;
